      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Edit",
      "Write",
      "Bash(java -version)",
      "Bash(git --version)",
      "Bash(gradle:*)",
      "Bash(codex:*)",
      "Bash(chmod +x scripts/*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Read",
      "Glob",
      "Grep",
      "Bash(scripts/usage-report.sh:*)",
      "Bash(java:*)",
      "Bash(node:*)",
      "Bash(which:*)",
      "Bash(where:*)",
      "Bash(winget install:*)",
      "Bash(winget list:*)",
      "Bash(setx:*)",
      "Bash(curl:*)",
      "Bash(unzip:*)",
      "Bash(export:*)",
      "Bash(echo:*)",
      "Bash(scripts/review.sh:*)"
